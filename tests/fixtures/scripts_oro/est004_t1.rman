RUN {
  SET COMMAND ID TO '&2';
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'C:\backups\XE\%d_EST004_T1_%T_%U.bkp';
  SET CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO 'C:\backups\XE\%F';
  BACKUP AS COMPRESSED BACKUPSET INCREMENTAL LEVEL 0 DATABASE TAG '&1' PLUS ARCHIVELOG;
  BACKUP CURRENT CONTROLFILE TAG '&1';
  BACKUP SPFILE TAG '&1';
  RELEASE CHANNEL c1;
}
