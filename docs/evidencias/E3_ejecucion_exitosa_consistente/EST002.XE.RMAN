SHUTDOWN IMMEDIATE;
STARTUP MOUNT;
RUN {
  SET COMMAND ID TO '&2';
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'C:\backups\XE\%d_EST002_T1_%T_%U.bkp';
  SET CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO 'C:\backups\XE\%F';
  BACKUP INCREMENTAL LEVEL 0 DATABASE TAG '&1';
  BACKUP CURRENT CONTROLFILE TAG '&1';
  BACKUP SPFILE TAG '&1';
  RELEASE CHANNEL c1;
}
ALTER DATABASE OPEN;
ALTER PLUGGABLE DATABASE ALL OPEN;
