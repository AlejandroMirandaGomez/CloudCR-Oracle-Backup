{% if sin_controlfile %}
STARTUP FORCE NOMOUNT;
SET DBID {{ dbid }};
RUN {
  SET CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO '{{ formato_autobackup }}';
{% if pieza %}
  RESTORE CONTROLFILE FROM '{{ pieza }}';
{% else %}
  RESTORE CONTROLFILE FROM AUTOBACKUP;
{% endif %}
}
ALTER DATABASE MOUNT;
{% else %}
STARTUP FORCE MOUNT;
{% endif %}
RESTORE DATABASE;
RECOVER DATABASE NOREDO;
ALTER DATABASE OPEN RESETLOGS;
